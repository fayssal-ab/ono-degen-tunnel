# ─────────────────────────────────────────────────────────────────────────
# ONO DEGEN TUNNEL — environment
# Copy to .env.local and fill in. .env.local is gitignored. Never put secrets
# in NEXT_PUBLIC_* — those are inlined into the browser bundle.
# MySQL is always required. CASINO_PROVIDER=demo only fakes the wager feed.
# ─────────────────────────────────────────────────────────────────────────

# ── Database (MySQL 8) ──
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ono_degen_tunnel
# Managed hosts requiring TLS (e.g. Aiven): base64 of the CA PEM (single line,
# survives .env import UIs that mangle multi-line values). Leave unset locally.
DB_SSL_CA_BASE64=

# ── Secrets ──
CRON_SECRET=dev-cron-secret-change-me
ADMIN_USERNAME=admin
ADMIN_PASSWORD=dev-admin-change-me
# Optional comma-separated Kick user IDs also granted admin.
ADMIN_KICK_IDS=
# 32+ random bytes; signs session cookies. `openssl rand -hex 32`
SESSION_SECRET=dev-session-secret-change-me-0000000000000000000000000000000000

# ── Casino provider ── manual | demo   (manual = wagers uploaded in Admin; demo fakes them)
CASINO_PROVIDER=manual

# ── Public casino branding (safe to expose) ──
# The sign-up card on the site: Stake with ONO's code. Set your real referral
# URL + code, or the card falls back to stake.com/?c=ONO.
NEXT_PUBLIC_STAKE_CODE=ONO
NEXT_PUBLIC_STAKE_URL=https://stake.com/?c=ONO

# ── Kick OAuth app (kick.com/settings/developer) ──
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
KICK_REDIRECT_URI=http://localhost:3000/api/auth/kick/callback
# ONO's numeric Kick user id: webhook events from other broadcasters are ignored.
KICK_BROADCASTER_USER_ID=

# ── Discord OAuth app (discord.com/developers/applications) — viewer sign-in ──
# Redirect to register: <site>/api/auth/discord/callback (defaults from NEXT_PUBLIC_SITE_URL)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=

# ── Discord prize tickets ── each new prize opens a private ticket channel
# named after the winner, with a green "Claim prize" button. Use a dedicated
# Discord application (not YUKI BOT: an Interactions Endpoint URL would take
# its slash commands away from the gateway). Invite it with Manage Channels +
# Manage Roles, enable the Server Members intent, and set its Interactions
# Endpoint URL to <site>/api/discord/interactions. Empty token = disabled.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=1552538464283525120
# Developer Portal → General Information → Public Key (verifies button clicks)
DISCORD_PUBLIC_KEY=

# ── Misc ──
# Stake slot catalogue feed (sharkz.gg, used with permission). Optional override.
STAKE_SLOTS_FEED_URL=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Optional rate-limit backend (falls back to DB-backed limiter) ──
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Kick chatroom id for the live chat reader (stable per channel). Find it by
# opening kick.com/api/v2/channels/<slug> in a browser and reading chatroom.id
KICK_CHATROOM_ID=
